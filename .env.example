# Copy this file to .env and fill it in.
ANTHROPIC_API_KEY=sk-ant-...
# Everyone at the company signs in with this one password.
APP_PASSWORD=pick-a-password
# Any long random string; keeps people signed in. Changing it signs everyone out.
SECRET_KEY=replace-with-a-long-random-string
